<Window x:Class="CorelSignStudio.App.OperatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CorelSignStudio.App"
        Title="{local:Loc App.Title}" Width="1180" Height="900"
        MinWidth="940" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDE2E7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="#B7161F"/>
            <Setter Property="Padding" Value="28,12"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <!-- An explicit TextBlock: the application-wide TextBlock style would otherwise force dark text. -->
                            <TextBlock Text="{TemplateBinding Content}" Foreground="White" FontFamily="Segoe UI Semibold"
                                       FontSize="{TemplateBinding FontSize}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#C01A23"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#C9CED4"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#C9CED4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E6EAEE"/>
            <Setter Property="BorderBrush" Value="#DDE2E7"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- Header: title, connection, active document -->
        <Border Grid.Row="0" Background="#17212B" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{local:Loc App.Title}" Foreground="White" FontFamily="Segoe UI Semibold" FontSize="22"/>
                    <TextBlock Text="{Binding ActiveDocumentText}" Foreground="#AEB8C2" FontSize="12.5" Margin="1,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#8A96A3"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#35C46A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectionText}" Foreground="#DCE3E9" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button Content="{local:Loc Header.Connect}" Command="{Binding ConnectCommand}" Padding="12,6" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="14,12,14,10" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0">

            <!-- ============================== OPERATOR ============================== -->
            <TabItem Header="{local:Loc Tab.Operator}">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" MinWidth="380"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="6*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: references + request -->
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="130"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{local:Loc Operator.ReferenceFiles}" Style="{StaticResource SectionTitle}"/>
                            <Border Grid.Row="1" x:Name="DropZone" AllowDrop="True" Drop="OnReferenceDrop" DragOver="OnReferenceDragOver"
                                    Background="#FAFBFC" BorderBrush="#B9C2CC" BorderThickness="1" CornerRadius="6">
                                <Grid>
                                    <ListBox ItemsSource="{Binding References}" SelectedItem="{Binding SelectedReference}"
                                             BorderThickness="0" Background="Transparent" Margin="4">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#E8ECEF" CornerRadius="3" Padding="6,1" Margin="0,0,8,0" MinWidth="42">
                                                        <TextBlock Text="{Binding FileTypeLabel}" FontSize="10.5" FontFamily="Segoe UI Semibold" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding FileName}" ToolTip="{Binding FilePath}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="{local:Loc Operator.DropHint}" Style="{StaticResource Hint}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Visibility>
                                            <Binding Path="References.Count">
                                                <Binding.Converter>
                                                    <x:Static Member="local:ZeroToVisibleConverter.Instance"/>
                                                </Binding.Converter>
                                            </Binding>
                                        </TextBlock.Visibility>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,14">
                                <Button Content="{local:Loc Common.AddFiles}" Command="{Binding AddReferenceCommand}" Padding="10,5" FontSize="12" Margin="0,0,8,0"/>
                                <Button Content="{local:Loc Common.Remove}" Command="{Binding RemoveReferenceCommand}" Padding="10,5" FontSize="12" Margin="0,0,8,0"/>
                                <Button Content="{local:Loc Operator.AnalyzeReference}" Command="{Binding AnalyzeReferenceCommand}" Padding="10,5" FontSize="12"
                                        ToolTip="{local:Loc Operator.AnalyzeTip}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3">
                                <Border Background="#FFF8E5" BorderBrush="#E8D9A8" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                                    <Border.Visibility>
                                        <Binding Path="HasPdfPages">
                                            <Binding.Converter>
                                                <x:Static Member="local:BoolToVisibleConverter.Instance"/>
                                            </Binding.Converter>
                                        </Binding>
                                    </Border.Visibility>
                                    <StackPanel>
                                        <TextBlock Text="{Binding PdfPagesText}" FontFamily="Segoe UI Semibold" FontSize="12.5"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="{local:Loc Reference.PageToAnalyze}" VerticalAlignment="Center" FontSize="12.5" Margin="0,0,8,0"/>
                                            <ComboBox ItemsSource="{Binding PdfPageNumbers}" SelectedItem="{Binding SelectedPdfPage}" MinWidth="70" Margin="0,0,8,0"/>
                                            <Button Content="{local:Loc Reference.PreviewPage}" Command="{Binding PreviewPdfPageCommand}" Padding="10,5" FontSize="12"/>
                                        </StackPanel>
                                        <Image Source="{Binding PdfPagePreview}" MaxHeight="170" HorizontalAlignment="Left" Margin="0,8,0,0" Stretch="Uniform">
                                            <Image.Visibility>
                                                <Binding Path="HasPdfPagePreview">
                                                    <Binding.Converter>
                                                        <x:Static Member="local:BoolToVisibleConverter.Instance"/>
                                                    </Binding.Converter>
                                                </Binding>
                                            </Image.Visibility>
                                        </Image>
                                    </StackPanel>
                                </Border>
                                <Expander Header="{local:Loc Operator.AnalysisHeader}" IsExpanded="True" Margin="0,0,0,12" FontFamily="Segoe UI Semibold" FontSize="12.5">
                                    <Expander.Style>
                                        <Style TargetType="Expander">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAnalysis}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Expander.Style>
                                    <TextBox Text="{Binding AnalysisSummary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Segoe UI" FontSize="12.5"
                                             Background="#FAFBFC" BorderBrush="#E6EAEE" MaxHeight="190" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"/>
                                </Expander>
                                <TextBlock Text="{local:Loc Operator.RequestTitle}" Style="{StaticResource SectionTitle}"/>
                            </StackPanel>
                            <TextBox Grid.Row="4" Text="{Binding Request, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" MinHeight="110"/>
                            <Expander Grid.Row="5" Header="{local:Loc Operator.ExamplesHeader}" Margin="0,8,0,0" FontSize="12"
                                      Foreground="{StaticResource MutedBrush}">
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                                               Text="{local:Loc Operator.ExamplesHint}"/>
                                    <ItemsControl ItemsSource="{Binding ExampleCommands}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Margin="0,1"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                            <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="{local:Loc Common.InspectDocument}" Command="{Binding InspectCommand}" Margin="0,0,10,0"/>
                                <Button Content="{local:Loc Operator.PreparePlan}" Command="{Binding PreparePlanCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Right: plan + execute + recipe + activity -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="5*"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="4*" MinHeight="190"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <TextBlock Text="{local:Loc Operator.ProposedOperations}" Style="{StaticResource SectionTitle}"/>
                                    <Button Content="{local:Loc Common.Clear}" Command="{Binding ClearPlanCommand}" HorizontalAlignment="Right" Padding="8,2" FontSize="11"/>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding PlanMessage}" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                                <ListBox Grid.Row="2" ItemsSource="{Binding ProposedOperations}" BorderBrush="#E6EAEE" Background="#FAFBFC"
                                         FontSize="13" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="2,3"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                                    <Button Content="{local:Loc Operator.Execute}" Command="{Binding ExecuteCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"/>
                                    <WrapPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                                        <Button Content="{local:Loc Operator.Compare}" Command="{Binding CompareCommand}" Padding="12,6" FontSize="12.5" Margin="4,2"
                                                ToolTip="{local:Loc Operator.CompareTip}"/>
                                        <Button Content="{local:Loc Operator.Improve}" Command="{Binding ImproveCommand}" Padding="12,6" FontSize="12.5" Margin="4,2"
                                                ToolTip="{local:Loc Operator.ImproveTip}"/>
                                        <Button Content="{local:Loc Operator.Preflight}" Command="{Binding PreflightCommand}" Padding="12,6" FontSize="12.5" Margin="4,2"
                                                ToolTip="{local:Loc Operator.PreflightTip}"/>
                                        <Button Content="{local:Loc Common.Cancel}" Command="{Binding CancelCommand}" Padding="12,6" FontSize="12.5" Margin="4,2"/>
                                    </WrapPanel>
                                    <ProgressBar Height="3" IsIndeterminate="True" Margin="0,8,0,0">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar">
                                                <Setter Property="Visibility" Value="Hidden"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                </StackPanel>
                                <Expander Grid.Row="4" Header="{local:Loc Operator.SaveAsRecipe}" Margin="0,6,0,0" FontFamily="Segoe UI Semibold" FontSize="12.5">
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{local:Loc Operator.RecipeName}" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding RecipeName, UpdateSourceTrigger=PropertyChanged}" FontSize="13"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{local:Loc Operator.RecipeVariables}" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding RecipeVariables, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" FontSize="13"
                                                     MinHeight="52" ToolTip="{local:Loc Operator.RecipeVariablesTip}"/>
                                        </StackPanel>
                                        <Button Grid.Column="4" Content="{local:Loc Operator.SaveAsRecipe}" Command="{Binding SaveRecipeCommand}" VerticalAlignment="Bottom"/>
                                    </Grid>
                                </Expander>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10,6,10,10">
                            <TabControl SelectedIndex="{Binding ReviewTabIndex}" BorderThickness="0" Background="Transparent">
                                <TabItem Header="{local:Loc Operator.Activity}" Padding="10,5" FontSize="12">
                                    <ListBox x:Name="LogList" ItemsSource="{Binding Logs}" BorderThickness="0" Background="#FAFBFC" Margin="0,6,0,0"
                                             FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="#394653"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </TabItem>
                                <TabItem Header="{local:Loc Review.ComparisonTab}" Padding="10,5" FontSize="12">
                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding ComparisonTitle}" FontFamily="Segoe UI Semibold" FontSize="15" Margin="2,0,0,6"/>
                                        <TextBox Text="{Binding ComparisonText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Segoe UI" FontSize="12.5"
                                                 Background="#FAFBFC" BorderBrush="#E6EAEE" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                                    </DockPanel>
                                </TabItem>
                                <TabItem Header="{local:Loc Review.PreflightTab}" Padding="10,5" FontSize="12">
                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding PreflightTitle}" FontFamily="Segoe UI Semibold" FontSize="15" Margin="2,0,0,6"/>
                                        <TextBox Text="{Binding PreflightText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Segoe UI" FontSize="12.5"
                                                 Background="#FAFBFC" BorderBrush="#E6EAEE" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                                    </DockPanel>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ========================== CURRENT DOCUMENT ========================== -->
            <TabItem Header="{local:Loc Tab.Document}">
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Margin="0,0,300,0">
                                <TextBlock Text="{Binding ActiveDocumentText}" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="{local:Loc Document.Hint}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button Content="{local:Loc Document.UseId}" Command="{Binding InsertShapeIdCommand}" Padding="10,5" FontSize="12" Margin="0,0,8,0"/>
                                <Button Content="{local:Loc Common.InspectDocument}" Command="{Binding InspectCommand}" Padding="10,5" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Shapes}" SelectedItem="{Binding SelectedShape}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{local:Loc Document.Column.Id}" Binding="{Binding Id}" FontFamily="Cascadia Mono, Consolas"/>
                                <DataGridTextColumn Header="{local:Loc Common.Type}" Binding="{Binding Type}"/>
                                <DataGridTextColumn Header="{local:Loc Common.Name}" Binding="{Binding Name}"/>
                                <DataGridTextColumn Header="{local:Loc Document.Column.Text}" Binding="{Binding Text}" Width="*"/>
                                <DataGridTextColumn Header="X" Binding="{Binding X}"/>
                                <DataGridTextColumn Header="Y" Binding="{Binding Y}"/>
                                <DataGridTextColumn Header="{local:Loc Document.Column.Width}" Binding="{Binding Width}"/>
                                <DataGridTextColumn Header="{local:Loc Document.Column.Height}" Binding="{Binding Height}"/>
                                <DataGridTextColumn Header="{local:Loc Document.Column.Layer}" Binding="{Binding Layer}"/>
                                <DataGridTextColumn Header="{local:Loc Document.Column.Group}" Binding="{Binding Group}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ========================= AUTOMATION RECIPES ========================= -->
            <TabItem Header="{local:Loc Tab.Recipes}">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{local:Loc Recipes.Saved}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="{local:Loc Recipes.Hint}"/>
                            <ListBox ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe}" DisplayMemberPath="Name" BorderBrush="#E6EAEE"/>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding SelectedRecipe.Name, FallbackValue={local:Loc Recipes.NoneSelected}, TargetNullValue={local:Loc Recipes.NoneSelected}}" FontFamily="Segoe UI Semibold" FontSize="17"/>
                            <TextBlock Grid.Row="1" Text="{Binding SelectedRecipe.Description}" Style="{StaticResource Hint}" Margin="0,4,0,12"/>
                            <TextBlock Grid.Row="2" Text="{local:Loc Recipes.Values}" Style="{StaticResource SectionTitle}"/>
                            <DataGrid Grid.Row="3" ItemsSource="{Binding RecipeVariableRows}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{local:Loc Recipes.Column.Variable}" Binding="{Binding Name}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas"/>
                                    <DataGridTextColumn Header="{local:Loc Recipes.Column.Value}" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridTextColumn Header="{local:Loc Common.Type}" Binding="{Binding Type}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="{local:Loc Recipes.Column.Note}" Binding="{Binding Description}" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="4" Margin="0,10,0,0">
                                <TextBlock Style="{StaticResource Hint}" Text="{local:Loc Recipes.FormulaHint}"/>
                                <TextBlock Text="{local:Loc Recipes.FormulaExamples}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="{local:Loc Recipes.Use}" Command="{Binding UseRecipeCommand}" Margin="0,0,10,0"/>
                                    <Button Content="{local:Loc Recipes.Delete}" Command="{Binding DeleteRecipeCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================= BATCH JOBS ============================= -->
            <TabItem Header="{local:Loc Tab.Batch}">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{local:Loc Batch.Title}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                       Text="{local:Loc Batch.Hint}"/>
                            <TextBlock Text="{local:Loc Batch.Recipe}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Recipes}" SelectedItem="{Binding BatchRecipe}" DisplayMemberPath="Name"/>
                            <TextBlock Text="{Binding BatchRecipeHint}" Style="{StaticResource Hint}" Margin="0,4,0,12"/>
                            <TextBlock Text="{local:Loc Batch.Data}" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding BatchDataPath, UpdateSourceTrigger=PropertyChanged}" FontSize="12.5"/>
                                <Button Grid.Column="2" Content="{local:Loc Common.Browse}" Command="{Binding BrowseBatchDataCommand}" Padding="10,5" FontSize="12"/>
                            </Grid>
                            <StackPanel Margin="0,0,0,8">
                                <StackPanel.Visibility>
                                    <Binding Path="HasWorksheets">
                                        <Binding.Converter>
                                            <x:Static Member="local:BoolToVisibleConverter.Instance"/>
                                        </Binding.Converter>
                                    </Binding>
                                </StackPanel.Visibility>
                                <TextBlock Text="{local:Loc Batch.Worksheet}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding WorksheetNames}" SelectedItem="{Binding SelectedWorksheet}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding BatchDataSummary}" Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                            <TextBlock Text="{local:Loc Batch.NamePattern}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding BatchNamePattern, UpdateSourceTrigger=PropertyChanged}" FontSize="12.5"
                                     ToolTip="{local:Loc Batch.NamePatternTip}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,12" Text="{local:Loc Batch.NamePatternHint}"/>
                            <TextBlock Text="{local:Loc Batch.OutputFolder}" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" FontSize="12.5"/>
                                <Button Grid.Column="2" Content="{local:Loc Common.Browse}" Command="{Binding BrowseOutputCommand}" Padding="10,5" FontSize="12"/>
                            </Grid>
                            <TextBlock Text="{local:Loc Batch.Outputs}" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <CheckBox Content="CDR" IsChecked="{Binding BatchCdr}" Margin="0,0,16,0"/>
                                <CheckBox Content="PDF" IsChecked="{Binding BatchPdf}" Margin="0,0,16,0"/>
                                <CheckBox Content="PNG" IsChecked="{Binding BatchPng}" Margin="0,0,16,0"/>
                                <CheckBox Content="SVG" IsChecked="{Binding BatchSvg}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{local:Loc Batch.Preview}" Command="{Binding PreviewBatchCommand}" Margin="0,0,8,0"/>
                                <Button Content="{local:Loc Batch.Run}" Command="{Binding RunBatchCommand}" Style="{StaticResource PrimaryButton}" Padding="18,9" FontSize="13" Margin="0,0,8,0"/>
                                <Button Content="{local:Loc Common.Cancel}" Command="{Binding CancelCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding BatchStatus}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                            <StackPanel Grid.Row="1">
                                <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding BatchPercent, Mode=OneWay}" Margin="0,2,0,10"/>
                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel.Visibility>
                                        <Binding Path="BatchRecordCount">
                                            <Binding.Converter>
                                                <x:Static Member="local:PositiveToVisibleConverter.Instance"/>
                                            </Binding.Converter>
                                        </Binding>
                                    </StackPanel.Visibility>
                                    <TextBlock Text="{local:Loc Batch.Data.SampleTitle}" Style="{StaticResource FieldLabel}"/>
                                    <ItemsControl ItemsSource="{Binding BatchSampleRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,1"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                            <DataGrid Grid.Row="2" ItemsSource="{Binding BatchRows}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{local:Loc Batch.Column.Row}" Binding="{Binding Row}"/>
                                    <DataGridTextColumn Header="{local:Loc Batch.Column.OutputName}" Binding="{Binding OutputName}" Width="2*"/>
                                    <DataGridTextColumn Header="{local:Loc Batch.Column.Status}" Binding="{Binding Status}" Width="3*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- =============================== ASSETS =============================== -->
            <TabItem Header="{local:Loc Tab.Assets}">
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="280"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{local:Loc Assets.Title}" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource Hint}" Text="{local:Loc Assets.Hint}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{local:Loc Assets.Search}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding AssetSearch, UpdateSourceTrigger=PropertyChanged}" FontSize="12.5"/>
                            </StackPanel>
                        </Grid>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Assets}" SelectedItem="{Binding SelectedAsset}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{local:Loc Common.Name}" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="{local:Loc Assets.Column.Category}" Binding="{Binding Category}" Width="*"/>
                                <DataGridTextColumn Header="{local:Loc Common.Type}" Binding="{Binding FileType}"/>
                                <DataGridTextColumn Header="{local:Loc Assets.Column.Tags}" Width="2*">
                                    <DataGridTextColumn.Binding>
                                        <Binding Path="Tags">
                                            <Binding.Converter>
                                                <x:Static Member="local:JoinConverter.Instance"/>
                                            </Binding.Converter>
                                        </Binding>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{local:Loc Assets.Column.Id}" Binding="{Binding Id}" FontFamily="Cascadia Mono, Consolas"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{local:Loc Assets.NewCategory}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding AssetCategory, UpdateSourceTrigger=PropertyChanged}" FontSize="12.5"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{local:Loc Assets.NewTags}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding AssetTags, UpdateSourceTrigger=PropertyChanged}" FontSize="12.5"/>
                            </StackPanel>
                            <Button Grid.Column="4" Content="{local:Loc Common.AddFiles}" Command="{Binding AddAssetCommand}" VerticalAlignment="Bottom"/>
                            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Content="{local:Loc Assets.Place}" Command="{Binding PlaceAssetCommand}" Margin="0,0,8,0"/>
                                <Button Content="{local:Loc Common.Remove}" Command="{Binding RemoveAssetCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ============================== HISTORY =============================== -->
            <TabItem Header="{local:Loc Tab.History}">
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Margin="0,0,260,0">
                                <TextBlock Text="{local:Loc History.Title}" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource Hint}" Text="{local:Loc History.Hint}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button Content="{local:Loc History.Reload}" Command="{Binding ReloadHistoryPlanCommand}" Padding="10,5" FontSize="12" Margin="0,0,8,0"/>
                                <Button Content="{local:Loc Common.Refresh}" Command="{Binding RefreshHistoryCommand}" Padding="10,5" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding HistoryRows}" SelectedItem="{Binding SelectedHistory}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{local:Loc History.Column.Time}" Binding="{Binding Time}" FontFamily="Cascadia Mono, Consolas"/>
                                <DataGridTextColumn Header="{local:Loc History.Column.Job}" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="{local:Loc History.Column.Result}" Binding="{Binding Result}" Width="3*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ============================== SETTINGS ============================== -->
            <TabItem Header="{local:Loc Tab.Settings}">
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="820" HorizontalAlignment="Left" Margin="0,0,12,0">
                        <TextBlock Text="{local:Loc Settings.Output}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{local:Loc Settings.OutputFolder}" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" FontSize="12.5"/>
                            <Button Grid.Column="2" Content="{local:Loc Common.Browse}" Command="{Binding BrowseOutputCommand}" Padding="10,5" FontSize="12"/>
                            <Button Grid.Column="4" Content="{local:Loc Common.Open}" Command="{Binding OpenOutputCommand}" Padding="10,5" FontSize="12"/>
                        </Grid>

                        <TextBlock Text="{local:Loc Settings.Safety}" Style="{StaticResource SectionTitle}"/>
                        <CheckBox IsChecked="{Binding RollbackOnFailure}" Content="{local:Loc Settings.Rollback}"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,18"
                                   Text="{local:Loc Settings.RollbackHint}"/>

                        <TextBlock Text="{local:Loc Settings.Ai.Title}" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{local:Loc Settings.Ai.Provider}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding AiProviderOptions}" SelectedItem="{Binding SelectedAiProvider}" DisplayMemberPath="DisplayName"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{local:Loc Settings.Ai.Model}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding AiModel, UpdateSourceTrigger=PropertyChanged}" FontSize="12.5"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="{local:Loc Settings.Ai.ApiKey}" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="ApiKeyBox" FontSize="14" Padding="10,7" BorderBrush="#CFD5DB"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding AiKeyStatus}" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{local:Loc Settings.Ai.PlannerMode}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding PlannerModeOptions}" SelectedItem="{Binding SelectedPlannerMode}" DisplayMemberPath="DisplayName"/>
                            </StackPanel>
                            <CheckBox Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,6" IsChecked="{Binding AiDebugLogging}"
                                      Content="{local:Loc Settings.Ai.DebugLogs}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="{local:Loc Settings.Ai.Save}" Click="OnSaveAiSettings" Padding="12,6" FontSize="12.5" Margin="0,0,8,0"/>
                            <Button Content="{local:Loc Settings.Ai.Test}" Command="{Binding TestAiCommand}" Padding="12,6" FontSize="12.5" Margin="0,0,8,0"/>
                            <Button Content="{local:Loc Settings.Ai.RemoveKey}" Click="OnRemoveAiKey" Padding="12,6" FontSize="12.5"/>
                        </StackPanel>
                        <TextBlock Text="{Binding AiTestResult}" FontFamily="Segoe UI Semibold" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{local:Loc Settings.Ai.PrivacyHint}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding AiSettingsPathText}" Margin="0,2,0,14"/>

                        <TextBlock Text="{local:Loc Settings.Planner}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding PlannerName}"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,18"
                                   Text="{local:Loc Settings.PlannerHint}"/>

                        <TextBlock Text="{local:Loc Settings.Data}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{local:Loc Settings.DataHint}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="{Binding DataFolder}" FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Content="{local:Loc Common.Open}" Command="{Binding OpenDataFolderCommand}" Padding="10,5" FontSize="12"/>
                        </StackPanel>
                        <TextBlock Text="{Binding LogFileText}" Style="{StaticResource Hint}" Margin="0,0,0,18"/>

                        <TextBlock Text="{local:Loc Settings.Legacy}" Style="{StaticResource SectionTitle}"/>
                        <Button Content="{local:Loc Settings.OpenLegacy}" Command="{Binding OpenLegacyToolCommand}" HorizontalAlignment="Left"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,18" Text="{local:Loc Settings.LegacyHint}"/>

                        <TextBlock Text="{local:Loc About.Title}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding AboutName}" FontFamily="Segoe UI Semibold" FontSize="16"/>
                        <TextBlock Text="{Binding AboutVersion}" FontSize="13" Margin="0,2,0,6"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{local:Loc About.Description}" Margin="0,0,0,8"/>
                    </StackPanel></ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#E8ECEF" BorderBrush="#D5DBE0" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11"
                           Text="{local:Loc Status.Engine}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
