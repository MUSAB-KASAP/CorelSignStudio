<Window x:Class="CorelSignStudio.App.OperatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CorelSignStudio.App"
        Title="Corel AI Operator" Width="1180" Height="900"
        MinWidth="940" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDE2E7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="#B7161F"/>
            <Setter Property="Padding" Value="28,12"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <!-- An explicit TextBlock: the application-wide TextBlock style would otherwise force dark text. -->
                            <TextBlock Text="{TemplateBinding Content}" Foreground="White" FontFamily="Segoe UI Semibold"
                                       FontSize="{TemplateBinding FontSize}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#C01A23"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#C9CED4"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#C9CED4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E6EAEE"/>
            <Setter Property="BorderBrush" Value="#DDE2E7"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- Header: title, connection, active document -->
        <Border Grid.Row="0" Background="#17212B" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Corel AI Operator" Foreground="White" FontFamily="Segoe UI Semibold" FontSize="22"/>
                    <TextBlock Text="{Binding ActiveDocumentText}" Foreground="#AEB8C2" FontSize="12.5" Margin="1,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#8A96A3"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#35C46A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectionText}" Foreground="#DCE3E9" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button Content="Connect" Command="{Binding ConnectCommand}" Padding="12,6" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="14,12,14,10" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0">

            <!-- ============================== OPERATOR ============================== -->
            <TabItem Header="Operator">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" MinWidth="380"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="6*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: references + request -->
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="130"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Reference files" Style="{StaticResource SectionTitle}"/>
                            <Border Grid.Row="1" x:Name="DropZone" AllowDrop="True" Drop="OnReferenceDrop" DragOver="OnReferenceDragOver"
                                    Background="#FAFBFC" BorderBrush="#B9C2CC" BorderThickness="1" CornerRadius="6">
                                <Grid>
                                    <ListBox ItemsSource="{Binding References}" SelectedItem="{Binding SelectedReference}"
                                             BorderThickness="0" Background="Transparent" Margin="4">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#E8ECEF" CornerRadius="3" Padding="6,1" Margin="0,0,8,0" MinWidth="42">
                                                        <TextBlock Text="{Binding FileType}" FontSize="10.5" FontFamily="Segoe UI Semibold" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding FileName}" ToolTip="{Binding FilePath}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="Drag JPG / PNG / PDF / SVG / CDR here" Style="{StaticResource Hint}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Visibility>
                                            <Binding Path="References.Count">
                                                <Binding.Converter>
                                                    <x:Static Member="local:ZeroToVisibleConverter.Instance"/>
                                                </Binding.Converter>
                                            </Binding>
                                        </TextBlock.Visibility>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,14">
                                <Button Content="Add files…" Command="{Binding AddReferenceCommand}" Padding="10,5" FontSize="12" Margin="0,0,8,0"/>
                                <Button Content="Remove" Command="{Binding RemoveReferenceCommand}" Padding="10,5" FontSize="12"/>
                            </StackPanel>

                            <TextBlock Grid.Row="3" Text="What do you want CorelDRAW to do?" Style="{StaticResource SectionTitle}"/>
                            <TextBox Grid.Row="4" Text="{Binding Request, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" MinHeight="110"/>
                            <Expander Grid.Row="5" Header="Commands the built-in test planner understands" Margin="0,8,0,0" FontSize="12"
                                      Foreground="{StaticResource MutedBrush}">
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                                               Text="One command per line. Use object ids from the Current document tab (for example shape_012), “selection” for what you selected in CorelDRAW, or an object name in quotes."/>
                                    <ItemsControl ItemsSource="{Binding ExampleCommands}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Margin="0,1"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                            <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Inspect Document" Command="{Binding InspectCommand}" Margin="0,0,10,0"/>
                                <Button Content="Prepare Plan" Command="{Binding PreparePlanCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Right: plan + execute + recipe + activity -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="5*"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="3*" MinHeight="150"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <TextBlock Text="Proposed operations" Style="{StaticResource SectionTitle}"/>
                                    <Button Content="Clear" Command="{Binding ClearPlanCommand}" HorizontalAlignment="Right" Padding="8,2" FontSize="11"/>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding PlanMessage}" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                                <ListBox Grid.Row="2" ItemsSource="{Binding ProposedOperations}" BorderBrush="#E6EAEE" Background="#FAFBFC"
                                         FontSize="13" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="2,3"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                                    <Button Content="EXECUTE IN CORELDRAW" Command="{Binding ExecuteCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"/>
                                    <ProgressBar Height="3" IsIndeterminate="True" Margin="0,8,0,0">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar">
                                                <Setter Property="Visibility" Value="Hidden"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                </StackPanel>
                                <Expander Grid.Row="4" Header="Save as Recipe" Margin="0,6,0,0" FontFamily="Segoe UI Semibold" FontSize="12.5">
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="RECIPE NAME" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding RecipeName, UpdateSourceTrigger=PropertyChanged}" FontSize="13"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="VARIABLES (NAME = value used in this job)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding RecipeVariables, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" FontSize="13"
                                                     MinHeight="52" ToolTip="Example:&#x0a;PERSON_NAME = Ahmet Yılmaz&#x0a;WIDTH_MM = 500"/>
                                        </StackPanel>
                                        <Button Grid.Column="4" Content="Save as Recipe" Command="{Binding SaveRecipeCommand}" VerticalAlignment="Bottom"/>
                                    </Grid>
                                </Expander>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Activity / Logs" Style="{StaticResource SectionTitle}"/>
                                <ListBox Grid.Row="1" x:Name="LogList" ItemsSource="{Binding Logs}" BorderThickness="0" Background="#FAFBFC"
                                         FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="#394653"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ========================== CURRENT DOCUMENT ========================== -->
            <TabItem Header="Current document">
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding ActiveDocumentText}" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Every object has a stable id. Positions are in millimetres from the page's top-left corner. Use the id in a request, e.g. “Move shape_012 10 mm right”."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button Content="Use id in request" Command="{Binding InsertShapeIdCommand}" Padding="10,5" FontSize="12" Margin="0,0,8,0"/>
                                <Button Content="Inspect Document" Command="{Binding InspectCommand}" Padding="10,5" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Shapes}" SelectedItem="{Binding SelectedShape}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" FontFamily="Cascadia Mono, Consolas"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}"/>
                                <DataGridTextColumn Header="Text" Binding="{Binding Text}" Width="*"/>
                                <DataGridTextColumn Header="X" Binding="{Binding X}"/>
                                <DataGridTextColumn Header="Y" Binding="{Binding Y}"/>
                                <DataGridTextColumn Header="Width" Binding="{Binding Width}"/>
                                <DataGridTextColumn Header="Height" Binding="{Binding Height}"/>
                                <DataGridTextColumn Header="Layer" Binding="{Binding Layer}"/>
                                <DataGridTextColumn Header="In group" Binding="{Binding Group}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ========================= AUTOMATION RECIPES ========================= -->
            <TabItem Header="Automation recipes">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Saved recipes" Style="{StaticResource SectionTitle}"/>
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="A recipe is a job that worked once, saved so it can be repeated with new values."/>
                            <ListBox ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe}" DisplayMemberPath="Name" BorderBrush="#E6EAEE"/>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding SelectedRecipe.Name, FallbackValue='No recipe selected', TargetNullValue='No recipe selected'}" FontFamily="Segoe UI Semibold" FontSize="17"/>
                            <TextBlock Grid.Row="1" Text="{Binding SelectedRecipe.Description}" Style="{StaticResource Hint}" Margin="0,4,0,12"/>
                            <TextBlock Grid.Row="2" Text="Values for this run" Style="{StaticResource SectionTitle}"/>
                            <DataGrid Grid.Row="3" ItemsSource="{Binding RecipeVariableRows}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Variable" Binding="{Binding Name}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas"/>
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Note" Binding="{Binding Description}" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Prepare Plan from Recipe" Command="{Binding UseRecipeCommand}" Margin="0,0,10,0"/>
                                <Button Content="Delete" Command="{Binding DeleteRecipeCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================= BATCH JOBS ============================= -->
            <TabItem Header="Batch jobs">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="One recipe, many rows" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                       Text="Each row of the CSV file produces one CorelDRAW output. Existing files are never overwritten."/>
                            <TextBlock Text="RECIPE" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Recipes}" SelectedItem="{Binding BatchRecipe}" DisplayMemberPath="Name"/>
                            <TextBlock Text="{Binding BatchRecipeHint}" Style="{StaticResource Hint}" Margin="0,4,0,12"/>
                            <TextBlock Text="DATA (CSV)" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding BatchCsvPath, UpdateSourceTrigger=PropertyChanged}" FontSize="12.5"/>
                                <Button Grid.Column="2" Content="Browse…" Command="{Binding BrowseBatchCsvCommand}" Padding="10,5" FontSize="12"/>
                            </Grid>
                            <TextBlock Text="FILE NAME PATTERN (optional)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding BatchNamePattern, UpdateSourceTrigger=PropertyChanged}" FontSize="12.5"
                                     ToolTip="Example: {{PERSON_NAME}}_{{ROW}}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,12" Text="Example: {{PERSON_NAME}}_{{ROW}}. Empty = recipe name + row number."/>
                            <TextBlock Text="OUTPUT FOLDER" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" FontSize="12.5"/>
                                <Button Grid.Column="2" Content="Browse…" Command="{Binding BrowseOutputCommand}" Padding="10,5" FontSize="12"/>
                            </Grid>
                            <TextBlock Text="OUTPUTS" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <CheckBox Content="CDR" IsChecked="{Binding BatchCdr}" Margin="0,0,16,0"/>
                                <CheckBox Content="PDF" IsChecked="{Binding BatchPdf}" Margin="0,0,16,0"/>
                                <CheckBox Content="PNG" IsChecked="{Binding BatchPng}" Margin="0,0,16,0"/>
                                <CheckBox Content="SVG" IsChecked="{Binding BatchSvg}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Preview" Command="{Binding PreviewBatchCommand}" Margin="0,0,8,0"/>
                                <Button Content="RUN BATCH" Command="{Binding RunBatchCommand}" Style="{StaticResource PrimaryButton}" Padding="18,9" FontSize="13" Margin="0,0,8,0"/>
                                <Button Content="Cancel" Command="{Binding CancelBatchCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding BatchStatus}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                            <ProgressBar Grid.Row="1" Height="6" Minimum="0" Maximum="100" Value="{Binding BatchPercent, Mode=OneWay}" Margin="0,2,0,10"/>
                            <DataGrid Grid.Row="2" ItemsSource="{Binding BatchRows}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Row" Binding="{Binding Row}"/>
                                    <DataGridTextColumn Header="Output name" Binding="{Binding OutputName}" Width="2*"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="3*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- =============================== ASSETS =============================== -->
            <TabItem Header="Assets">
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="280"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Asset library" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Logos, icons, traffic signs, symbols, customer files and reusable CorelDRAW files."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="SEARCH" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding AssetSearch, UpdateSourceTrigger=PropertyChanged}" FontSize="12.5"/>
                            </StackPanel>
                        </Grid>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Assets}" SelectedItem="{Binding SelectedAsset}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding FileType}"/>
                                <DataGridTextColumn Header="Tags" Width="2*">
                                    <DataGridTextColumn.Binding>
                                        <Binding Path="Tags">
                                            <Binding.Converter>
                                                <x:Static Member="local:JoinConverter.Instance"/>
                                            </Binding.Converter>
                                        </Binding>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" FontFamily="Cascadia Mono, Consolas"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="CATEGORY FOR NEW FILES" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding AssetCategory, UpdateSourceTrigger=PropertyChanged}" FontSize="12.5"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="TAGS (comma separated)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding AssetTags, UpdateSourceTrigger=PropertyChanged}" FontSize="12.5"/>
                            </StackPanel>
                            <Button Grid.Column="4" Content="Add files…" Command="{Binding AddAssetCommand}" VerticalAlignment="Bottom"/>
                            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Content="Place in document" Command="{Binding PlaceAssetCommand}" Margin="0,0,8,0"/>
                                <Button Content="Remove" Command="{Binding RemoveAssetCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ============================== HISTORY =============================== -->
            <TabItem Header="History">
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Execution history" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Every executed plan is kept with its result, so a job can be reviewed, repeated or saved as a recipe."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button Content="Load plan again" Command="{Binding ReloadHistoryPlanCommand}" Padding="10,5" FontSize="12" Margin="0,0,8,0"/>
                                <Button Content="Refresh" Command="{Binding RefreshHistoryCommand}" Padding="10,5" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding HistoryRows}" SelectedItem="{Binding SelectedHistory}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" FontFamily="Cascadia Mono, Consolas"/>
                                <DataGridTextColumn Header="Job" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="3*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ============================== SETTINGS ============================== -->
            <TabItem Header="Settings">
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="Output" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="DEFAULT OUTPUT FOLDER" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" FontSize="12.5"/>
                            <Button Grid.Column="2" Content="Browse…" Command="{Binding BrowseOutputCommand}" Padding="10,5" FontSize="12"/>
                            <Button Grid.Column="4" Content="Open" Command="{Binding OpenOutputCommand}" Padding="10,5" FontSize="12"/>
                        </Grid>

                        <TextBlock Text="Safety" Style="{StaticResource SectionTitle}"/>
                        <CheckBox IsChecked="{Binding RollbackOnFailure}" Content="If a step fails, undo everything the plan changed in my open document"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,18"
                                   Text="A successful plan is always a single Ctrl+Z step in CorelDRAW. Plans that delete objects or close a document ask for confirmation first. Files already written by a failed plan are kept."/>

                        <TextBlock Text="Planner" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding PlannerName}"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,18"
                                   Text="The built-in planner recognises only a small set of test commands. The AI planner will plug in here without changing the rest of the application."/>

                        <TextBlock Text="Data" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Recipes, assets and history are stored as readable JSON files in:"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="{Binding DataFolder}" FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Content="Open" Command="{Binding OpenDataFolderCommand}" Padding="10,5" FontSize="12"/>
                        </StackPanel>
                        <TextBlock Text="{Binding LogPath, StringFormat='Log file: {0}'}" Style="{StaticResource Hint}" Margin="0,0,0,18"/>

                        <TextBlock Text="Legacy" Style="{StaticResource SectionTitle}"/>
                        <Button Content="Open the sign template tool" Command="{Binding OpenLegacyToolCommand}" HorizontalAlignment="Left"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="The original parametric sign generator, kept available as it was."/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#E8ECEF" BorderBrush="#D5DBE0" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11"
                           Text="CorelDRAW 2026 COM • dedicated STA thread"/>
            </Grid>
        </Border>
    </Grid>
</Window>
